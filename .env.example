PORT=8787
BASE_URL=http://localhost:8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/health_ai

# Oura developer application
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Optional. Defaults to <BASE_URL>/auth/oura/callback when omitted.
OURA_REDIRECT_URI=http://localhost:8787/auth/oura/callback
OURA_SCOPES=daily heartrate workout spo2

# Development-only authenticated user. Replace with real auth before multi-user launch.
TOKEN_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Private-alpha incremental sync. Keeps the recent cache fresh without doing historical backfill.
BACKGROUND_SYNC_ENABLED=true
BACKGROUND_SYNC_INTERVAL_MINUTES=15
BACKGROUND_SYNC_RECENT_DAYS=3
BACKGROUND_SYNC_STARTUP_DELAY_SECONDS=10
